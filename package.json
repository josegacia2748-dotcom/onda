{
  "name": "onda",
  "private": true,
  "version": "1.0.0",
  "description": "Streaming de musica ligero con descargas offline y tema personalizable",
  "author": "josegacia2748-dotcom",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-audio.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audio": "node scripts/generate-audio.mjs",
    "smoke": "node scripts/smoke.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android": "npm run cap:sync && cap open android",
    "android:apk": "npm run cap:sync && node scripts/android-apk.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:build:portable": "npm run build && electron-builder --win portable",
    "electron:build:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.jgarapps.onda",
    "productName": "Onda",
    "copyright": "Copyright © 2026 Onda",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onda",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
